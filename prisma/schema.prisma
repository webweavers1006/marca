generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// 1. Tabla: tipos_integrantes
model tipos_integrantes {
  id              Int           @id @default(autoincrement())
  tipo_integrante String        @db.VarChar(100)
  integrantes     integrantes[]
}

// 2. Tabla: areas_xp
model areas_xp {
  id          Int           @id @default(autoincrement())
  area        String        @db.VarChar(100)
  integrantes integrantes[]
}

// 3. Tabla: tiempos_xp
model tiempos_xp {
  id          Int           @id @default(autoincrement())
  tiempo      String        @db.VarChar(100)
  integrantes integrantes[]
}

// 4. Tabla: niveles_educativos
model niveles_educativos {
  id              Int           @id @default(autoincrement())
  nivel_educativo String        @db.VarChar(100)
  integrantes     integrantes[]
}

// 5. Tabla: integrantes
model integrantes {
  id                 Int      @id @default(autoincrement())
  nombre             String   @db.VarChar(255)
  identificacion     String   @db.VarChar(50)
  email              String?  @db.VarChar(255)
  telefono           String?  @db.VarChar(50)
  
  id_tipo_integrante Int?
  id_area_xp         Int?
  id_tiempo_xp       Int?
  id_nivel_educativo Int?

  tipo_integrante    tipos_integrantes?  @relation(fields: [id_tipo_integrante], references: [id])
  area_xp            areas_xp?           @relation(fields: [id_area_xp], references: [id])
  tiempo_xp          tiempos_xp?         @relation(fields: [id_tiempo_xp], references: [id])
  nivel_educativo    niveles_educativos? @relation(fields: [id_nivel_educativo], references: [id])

  postulaciones      integrantes_postulaciones[]
}

// 6. Tabla: empresas
model empresas {
  id                     Int      @id @default(autoincrement())
  nombre                 String   @db.VarChar(255)
  numero_registro_fiscal String?  @db.VarChar(100)
  email                  String?  @db.VarChar(255)
  telefono               String?  @db.VarChar(50)
  id_pais                Int?
  id_estado              Int?
  provincia_municipio    String?  @db.VarChar(255)
  ciudad                 String?  @db.VarChar(255)

  pais                   paises?  @relation(fields: [id_pais], references: [id])
  estado_rel             estados? @relation(fields: [id_estado], references: [id_estado])

  postulaciones          empresas_postulaciones[]
}

// 6.1 Tabla: paises
model paises {
  id           Int       @id @default(autoincrement())
  pais         String?   @db.VarChar(150)
  codigo       Int
  id_condicion Int?     
  created      DateTime?
  updated      DateTime?

  empresas     empresas[]
}

// 6.2 Tabla: estados
model estados {
  id_estado    Int      @id @default(autoincrement())
  estado       String   @db.VarChar(250)
  iso_3166_2   String   @map("iso_3166-2") @db.VarChar(4)

  empresas     empresas[]
}

// 7. Tabla: tipo_participacion
model tipo_participacion {
  id            Int      @id @default(autoincrement())
  participacion String   @db.VarChar(100)
  postulaciones postulaciones[]
}

// 8. Tabla: medios_difusion
model medios_difusion {
  id            Int      @id @default(autoincrement())
  medio         String   @db.VarChar(100)
  postulaciones postulaciones[]
}

// 9. Tabla: postulaciones
model postulaciones {
  id                             Int      @id @default(autoincrement())
  id_tipo_participacion          Int?
  descripcion_proyecto_relevante String?  @db.Text
  enlace_proyectos_previos       String?  @db.VarChar(500)
  id_medio_difusion              Int?
  fase2                          Boolean  @default(false)

  tipo_participacion             tipo_participacion? @relation(fields: [id_tipo_participacion], references: [id])
  medio_difusion                 medios_difusion?    @relation(fields: [id_medio_difusion], references: [id])

  empresas                       empresas_postulaciones[]
  integrantes                    integrantes_postulaciones[]
}

// 10. Tabla puente: empresas_postulaciones
model empresas_postulaciones {
  id             Int      @id @default(autoincrement())
  id_empresa     Int?
  id_postulacion Int?

  empresa        empresas?      @relation(fields: [id_empresa], references: [id])
  postulacion    postulaciones? @relation(fields: [id_postulacion], references: [id])
}

// 11. Tabla puente: integrantes_postulaciones
model integrantes_postulaciones {
  id             Int      @id @default(autoincrement())
  id_integrante  Int?
  id_postulacion Int?

  integrante     integrantes?   @relation(fields: [id_integrante], references: [id])
  postulacion    postulaciones? @relation(fields: [id_postulacion], references: [id])
}
